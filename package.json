{
  "name": "sms",
  "type": "module",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.3",
    "@wdio/allure-reporter": "^9.12.6",
    "@wdio/cli": "^9.12.7",
    "@wdio/globals": "^9.12.7",
    "@wdio/local-runner": "^9.12.7",
    "@wdio/mocha-framework": "^9.12.6",
    "@wdio/spec-reporter": "^9.12.6",
    "@wdio/types": "^9.12.6",
    "allure-commandline": "^2.34.0",
    "http-server": "^14.1.1",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2"
  },
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:report": "npm run test && allure open",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open allure-report",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "server": "http-server -p 8080",
    "test:with-server": "npm run server & sleep 2 && npm test && pkill -f http-server",
    "test:with-server:report": "npm run server & sleep 2 && npm run test:report && pkill -f http-server"
  },
  "dependencies": {
    "wdio-video-reporter": "^6.1.1"
  }
}
